# Private hosted-service template. See docs/RAILWAY_SUPABASE.md.
NODE_ENV=production
SOLAIR_AUTH_PROVIDER=supabase
SOLAIR_REALTIME_PROVIDER=supabase
DATABASE_URL=
SOLAIR_DATABASE_CA=
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Exact permanent HTTPS origin, without a trailing slash.
SOLAIR_PUBLIC_URL=
# Optional separate listener: uncomment only with the real full HTTPS URL.
# SOLAIR_DEVICE_INGEST_URL=https://devices.your-domain.example/api/ingest
# Railway supplies PORT. Never enable SOLAIR_ALLOW_LOCAL_PREVIEW there.
