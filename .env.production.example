# Configure in Railway Variables. Blank credentials are intentional.
# Never commit secrets or use NEXT_PUBLIC_* for private keys.
NODE_ENV=production
SOLAIR_AUTH_PROVIDER=supabase
SOLAIR_REALTIME_PROVIDER=supabase
DATABASE_URL=
SOLAIR_DATABASE_CA=
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SOLAIR_PUBLIC_URL=
SOLAIR_LOCATION_RETENTION_DAYS=30
# Bootstrap only; remove admin password after successful creation.
SOLAIR_ADMIN_EMAIL=
SOLAIR_ADMIN_PASSWORD=
SOLAIR_ORG_ID=manila
SOLAIR_ORG_NAME=Manila Central TODA
